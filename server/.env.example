PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-at-least-32-random-characters
CLIENT_ORIGINS=http://localhost:5173
NODE_ENV=development

# OpenAI-compatible analytics chatbot configuration (DEMO PLACEHOLDERS ONLY).
# Replace these with the endpoint, API key, and model from your provider.
# Never commit a real API key. The demo key below is intentionally invalid.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-demo-replace-with-your-api-key
OPENAI_MODEL=gpt-4o-mini
